{
  "name": "@mrcarb0n/opencode-mcp-watchdog",
  "version": "1.2.0",
  "description": "Opencode plugin: auto-check and reconnect failed MCP servers, with TUI toast status",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test",
    "check": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --check src test *.md",
    "format:fix": "prettier --write src test *.md"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mcp",
    "watchdog",
    "healthcheck"
  ],
  "author": "MrCarb0n",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrCarb0n/opencode-mcp-watchdog.git"
  },
  "bugs": {
    "url": "https://github.com/MrCarb0n/opencode-mcp-watchdog/issues"
  },
  "homepage": "https://github.com/MrCarb0n/opencode-mcp-watchdog#readme",
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@opencode-ai/sdk": "^1.18.30"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.5.0",
    "eslint": "^9.39.1",
    "globals": "^17.12.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
